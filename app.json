{
  "expo": {
    "name": "phonebook",
    "slug": "phonebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/phonebookLogo.png",
    "scheme": "phonebook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/phonebookLogo.png",
        "backgroundImage": "./assets/images/phonebookLogo.png",
        "monochromeImage": "./assets/images/phonebookLogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "@assets/images/phonebookLogo.png",
          "imageWidth": 200,
          "borderRadius": 20,
          "dark": {
            "backgroundColor": "#000000",
            "image": "@assets/images/phonebookLogo-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
